# Configuration propre à chaque machine (générée par install.bat / detect-config.ps1)
config.json

# Données de la version portable (config.json, journal, icônes composées), à côté de setup.bat
/data/
app/portable.json

# Journal du lanceur (trace horodatée de chaque lancement, pour le support)
launch.log

# Raccourcis générés (chemins absolus, propres à la machine)
*.lnk

# Icônes compagnon composées par create-shortcuts.ps1 (drapeau + pastille), dans chaque jeu d'icônes
app/ico/*/companion/

# Windows / éditeurs
Thumbs.db
desktop.ini
.vscode/
.idea/

# Archives de release (tools/make-release.ps1)
dist/

# Propositions et essais visuels (jamais versionnes)
tmp/
