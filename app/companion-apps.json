[
  {
    "id": "porofessor",
    "name": "Porofessor",
    "signer": { "organization": "Overwolf Ltd", "country": "IL" },
    "processNames": ["Overwolf"],
    "launch": {
      "path": "%ProgramFiles(x86)%\\Overwolf\\OverwolfLauncher.exe",
      "arguments": "-launchapp pibhbkkgefgheeglaeemkkfjlhidhcedalapdggh -from-startmenu"
    },
    "detect": {
      "registryDisplayNamePattern": "^Porofessor",
      "path": "%LOCALAPPDATA%\\Overwolf\\Extensions\\pibhbkkgefgheeglaeemkkfjlhidhcedalapdggh"
    },
    "install": {
      "strategy": "download",
      "url": "https://download.overwolf.com/install/Download?Name=Porofessor.gg&ExtensionId=pibhbkkgefgheeglaeemkkfjlhidhcedalapdggh&Channel=web_dl_btn",
      "arguments": "/S",
      "timeoutSeconds": 300,
      "notice": "Si Overwolf n'est pas encore installé, son installeur affiche sa fenêtre : suivez ses étapes (environ 1 min).",
      "fallback": "browser",
      "browserUrl": "https://www.overwolf.com/app/trebonius-porofessor.gg"
    },
    "uninstall": {
      "mode": "interactive",
      "dialogProcessNames": ["OWUninstallMenu"],
      "notice": "Overwolf va ouvrir son menu de désinstallation avec Overwolf ET Porofessor cochés. Décochez Overwolf si vous l'utilisez pour d'autres applications, puis cliquez sur Uninstall."
    }
  },
