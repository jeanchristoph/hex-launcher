[
  {
    "id": "porofessor",
    "name": "Porofessor",
    "signer": { "organization": "Overwolf Ltd", "country": "IL" },
    "badge": { "glyph": "P", "color": "#ECEAE4", "glyphColor": "#E36A62" },
    "processNames": ["Overwolf"],
    "launch": {
      "path": "%ProgramFiles(x86)%\\Overwolf\\OverwolfLauncher.exe",
      "arguments": "-launchapp pibhbkkgefgheeglaeemkkfjlhidhcedalapdggh -from-startmenu"
    },
    "detect": {
      "registryDisplayNamePattern": "^Porofessor",
      "path": "%LOCALAPPDATA%\\Overwolf\\Extensions\\pibhbkkgefgheeglaeemkkfjlhidhcedalapdggh"
    },
    "install": {
      "strategy": "download",
      "url": "https://download.overwolf.com/install/Download?Name=Porofessor.gg&ExtensionId=pibhbkkgefgheeglaeemkkfjlhidhcedalapdggh&Channel=web_dl_btn",
      "arguments": "/S",
      "timeoutSeconds": 300,
      "notice": {
        "fr": "Si Overwolf n'est pas encore installé, son installeur affiche sa fenêtre : suivez ses étapes (environ 1 min).",
        "en": "If Overwolf is not installed yet, its installer shows its own window: follow its steps (about 1 min).",
        "ja": "Overwolf が未インストールの場合、そのインストーラーのウィンドウが表示されます。手順に従ってください（約 1 分）。"
      },
      "fallback": "browser",
      "browserUrl": "https://www.overwolf.com/app/trebonius-porofessor.gg"
    },
    "uninstall": {
      "mode": "interactive",
      "dialogProcessNames": ["OWUninstallMenu"],
      "notice": {
        "fr": "Overwolf va ouvrir son menu de désinstallation avec Overwolf ET Porofessor cochés. Décochez Overwolf si vous l'utilisez pour d'autres applications, puis cliquez sur Uninstall.",
        "en": "Overwolf will open its uninstall menu with Overwolf AND Porofessor checked. Uncheck Overwolf if you use it for other applications, then click Uninstall.",
        "ja": "Overwolf のアンインストールメニューが、Overwolf と Porofessor の両方にチェックが入った状態で開きます。他のアプリで Overwolf を使っている場合はチェックを外してから、Uninstall をクリックしてください。"
      }
    }
  },
  {
    "id": "blitz",
    "name": "Blitz",
    "signer": { "organization": "Swift Media Entertainment, Inc.", "country": "US" },
    "badge": { "glyph": "B", "color": "#E4103F" },
