    },
    "install": {
      "strategy": "winget",
      "wingetId": "Blitz.Blitz",
      "timeoutSeconds": 180,
      "fallback": "browser",
      "browserUrl": "https://blitz.gg/download"
    },
    "uninstall": {
      "mode": "silent"
    }
  },
